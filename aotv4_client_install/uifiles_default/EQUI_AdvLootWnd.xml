	<Button item="ALW_Sell"><ScreenID>ALW_Sell</ScreenID><RelativePosition>true</RelativePosition><Location><X>224</X><Y>340</Y></Location><Size><CX>104</CX><CY>26</CY></Size><Text>Sell</Text><TextColor><R>255</R><G>230</G><B>140</B></TextColor><Template>BDT_Normal</Template></Button>
