<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
	<Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />

	<!-- AoTv4 Advanced Loot window (CCustomWnd "AdvLootWnd"), modelled on the live client's
	     EQUI_AdvancedLootWnd.xml (ADLW_*).
	     LAYOUT: everything uses AutoStretch + anchors, exactly like the native window, so the list
	     fills whatever width the client actually gives the window and its scrollbar always stays on
	     the visible right edge. Fixed pixel positions were clipping on the right.
	     LIMITS of this RoF2 build (all verified, not assumed):
	       * no Sortable / per-column Tooltip: live uses them, no RoF2-shipped file does, and one
	         unsupported token aborts the WHOLE file at parse time.
	       * one Listbox, no nested container Screens: both have caused UI-load errors here.
	       * decision cells cannot be buttons. CListWnd::GetCurCol has no address in this build and the
	         (point, row, col) GetItemAtPoint overload is unmapped, so the column a click landed in is
	         unknowable. Cells show STATE; the buttons below act on the selected row, and right-click
	         on a row links the item so it can be inspected.
	     NOTE: never put a double hyphen inside an XML comment. It is illegal XML, the parser aborts
	     the whole file, and the client CRASHES at UI load. Run validate_ui_xml.sh before copying. -->

	<!-- ===== the loot list: stretches to fill the window ===== -->

	<!-- ===== header ===== -->
	<Label item="ALW_Hint">
		<ScreenID>ALW_Hint</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location><X>10</X><Y>8</Y></Location>
		<Size><CX>380</CX><CY>18</CY></Size>
		<Text>Personal Loot</Text>
		<TextColor><R>228</R><G>210</G><B>142</B></TextColor>
		<NoWrap>true</NoWrap>
	</Label>

	<!-- ===== group context readout, just under the list ===== -->

	<!-- ===== row 1: loot actions (anchored to the bottom edge) ===== -->

	<!-- ===== row 2: persistent rules + filter view ===== -->

	<!-- ===== row 3: toggles + refresh ===== -->

	<!-- Item detail: the client's own STML renderer, the same one the stock item display uses, so an
	     inspected item reads exactly like a real inspect. Filled via CStmlWnd::SetSTMLText from the
	     server's LOOTINFO line; nothing is pushed to chat. -->
	<Button item="ALW_SellAll"><ScreenID>ALW_SellAll</ScreenID><RelativePosition>true</RelativePosition><Location><X>208</X><Y>4</Y></Location><Size><CX>112</CX><CY>22</CY></Size><Text>Sell All</Text><TextColor><R>255</R><G>230</G><B>140</B></TextColor><Template>BDT_Normal</Template></Button>
	<Button item="ALW_LootAll"><ScreenID>ALW_LootAll</ScreenID><RelativePosition>true</RelativePosition><Location><X>324</X><Y>4</Y></Location><Size><CX>112</CX><CY>22</CY></Size><Text>Loot All</Text><TextColor><R>140</R><G>255</G><B>140</B></TextColor><Template>BDT_Normal</Template></Button>
	<Listbox item="ALW_ItemList"><ScreenID>ALW_ItemList</ScreenID><DrawTemplate>WDT_Inner</DrawTemplate><RelativePosition>true</RelativePosition><AutoStretch>true</AutoStretch><LeftAnchorToLeft>true</LeftAnchorToLeft><LeftAnchorOffset>8</LeftAnchorOffset><RightAnchorToLeft>false</RightAnchorToLeft><RightAnchorOffset>8</RightAnchorOffset><TopAnchorToTop>true</TopAnchorToTop><TopAnchorOffset>28</TopAnchorOffset><BottomAnchorToTop>true</BottomAnchorToTop><BottomAnchorOffset>150</BottomAnchorOffset><Location><X>8</X><Y>28</Y></Location><Size><CX>428</CX><CY>122</CY></Size><TextColor><R>255</R><G>255</G><B>255</B></TextColor><Style_Border>true</Style_Border><Style_VScroll>true</Style_VScroll><Columns><Width>200</Width><Heading>Item Name</Heading></Columns><Columns><Width>70</Width><Heading>Value</Heading></Columns><Columns><Width>140</Width><Heading>NPC Name</Heading></Columns></Listbox>
	<STMLbox item="ALW_Detail"><ScreenID>ALW_Detail</ScreenID><DrawTemplate>WDT_Inner</DrawTemplate><RelativePosition>true</RelativePosition><AutoStretch>true</AutoStretch><LeftAnchorToLeft>true</LeftAnchorToLeft><LeftAnchorOffset>8</LeftAnchorOffset><RightAnchorToLeft>false</RightAnchorToLeft><RightAnchorOffset>8</RightAnchorOffset><TopAnchorToTop>true</TopAnchorToTop><TopAnchorOffset>156</TopAnchorOffset><BottomAnchorToTop>false</BottomAnchorToTop><BottomAnchorOffset>122</BottomAnchorOffset><Location><X>8</X><Y>156</Y></Location><Size><CX>428</CX><CY>162</CY></Size><Style_Border>true</Style_Border><Style_VScroll>true</Style_VScroll><TextColor><R>240</R><G>240</G><B>240</B></TextColor></STMLbox>
	<Button item="ALW_Loot"><ScreenID>ALW_Loot</ScreenID><RelativePosition>true</RelativePosition><Location><X>8</X><Y>340</Y></Location><Size><CX>104</CX><CY>26</CY></Size><Text>Loot</Text><TextColor><R>140</R><G>255</G><B>140</B></TextColor><Template>BDT_Normal</Template></Button>
